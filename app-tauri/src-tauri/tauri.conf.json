{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiotAccountManager",
  "mainBinaryName": "RiotAccountManager",
  "version": "3.2.0",
  "identifier": "com.riotaccountmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Riot Account Manager",
        "width": 440,
        "height": 600,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Manage and auto-login multiple Riot Games accounts",
    "longDescription": "Riot Account Manager helps you manage multiple Riot Games accounts and auto-fill the Riot Client login. No Java required.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Vietnamese"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {}
}
