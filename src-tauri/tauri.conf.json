{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameAccountSwitcher",
  "mainBinaryName": "GameAccountSwitcher",
  "version": "4.0.0",
  "identifier": "vn.khoa.gameaccountswitcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Game Account Switcher",
        "width": 480,
        "height": 680,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Đổi tài khoản Riot Client và Garena chỉ với một cú bấm",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
